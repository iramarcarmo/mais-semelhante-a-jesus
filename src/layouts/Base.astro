---
const { title='Mais Semelhante a Jesus', description='Série de estudos bíblicos de Wilson Valentim' }=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const url=(p='')=>`${base}/${p.replace(/^\//,'')}`;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#4f241d"/><title>{title} | Mais Semelhante a Jesus</title><meta name="description" content={description}/><link rel="icon" href={url('favicon.svg')}/></head><body>
<header class="site-head"><div class="top"><a class="brand" href={url('')}>✦ <span>Mais Semelhante a Jesus</span></a><nav aria-label="Menu principal"><a href={url('')}>Início</a><a href={url('licoes/')}>Lições</a><a href={url('sobre/')}>Sobre</a></nav></div></header>
<main><slot/></main><footer><p><strong>Mais Semelhante a Jesus</strong> • Wilson Valentim • 2026</p><p>Série de estudos bíblicos · Conhecer · Refletir · Viver · Servir</p></footer>
</body></html>
<style is:global>
:root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#322a25;background:#faf7f1;line-height:1.65;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:#6b332a}a:hover{text-decoration-color:#bb8749}button,input,textarea{font:inherit}img{max-width:100%;height:auto}h1,h2,h3{font-family:Georgia,'Times New Roman',serif;color:#4d251f;line-height:1.2}h1{font-size:clamp(2.1rem,5vw,3.9rem)}h2{font-size:clamp(1.4rem,3vw,2.1rem)}p{max-width:80ch}.site-head{background:#4a231e;color:white}.top{max-width:1140px;margin:auto;min-height:76px;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px}.site-head a{color:white;text-decoration:none}.brand{font-family:Georgia,serif;font-weight:bold;font-size:1.1rem}.site-head nav{display:flex;gap:20px}.container{max-width:1120px;margin:auto;padding:30px 22px 70px}.eyebrow{text-transform:uppercase;color:#966c37;letter-spacing:.15em;font-weight:750;font-size:.78rem}.btn{display:inline-block;padding:11px 19px;background:#663129;color:#fff!important;border-radius:6px;text-decoration:none;font-weight:700}.btn.alt{background:transparent;color:#663129!important;border:1px solid #bda98e}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:22px}.card{display:block;overflow:hidden;background:white;border:1px solid #e7dfd5;border-radius:12px;text-decoration:none;box-shadow:0 3px 16px #4433220b;transition:transform .15s}.card:hover{transform:translateY(-3px)}.card img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}.card .inner{padding:17px}.card h3{margin:5px 0 0;font-size:1.19rem}.number{font-size:.75rem;letter-spacing:.12em;color:#986b33;font-weight:800}footer{background:#efe8dd;text-align:center;padding:30px 20px;color:#5f5146}footer p{margin:0 auto 4px}.lesson{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:48px;align-items:start}.paper{min-width:0}.lesson-cover{width:min(100%,560px);border-radius:10px;display:block;margin:12px 0 28px}.prose{font-size:1.07rem;line-height:1.85}.prose h2{border-top:1px solid #e2d7c6;padding-top:28px;margin-top:35px}.prose h3{font-size:1.35rem;margin-top:30px}.prose blockquote{border-left:4px solid #ae8150;margin-left:0;padding:6px 24px;background:#f3eadb}.prose li{margin-bottom:12px}.sidebar{position:sticky;top:20px;background:#f2eadf;padding:20px;border-radius:9px;font-size:.9rem}.sidebar h3{font-size:1.15rem}.sidebar label{font-weight:700;display:block;margin:12px 0 4px}.sidebar textarea{width:100%;min-height:150px;border:1px solid #cdbca9;border-radius:5px;padding:10px;background:white}.lesson-nav{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;margin-top:45px}.muted{color:#786d61}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:30px 0 60px}.hero img{width:100%;max-height:490px;object-fit:contain;border-radius:12px}.hero .sub{font-size:1.18rem;color:#6d6055}.section-title{margin:15px 0 28px}@media(max-width:760px){.top{align-items:flex-start;flex-direction:column;gap:7px}.site-head nav{gap:16px}.lesson,.hero{grid-template-columns:1fr}.sidebar{position:static}.hero{padding:5px 0 35px}.hero img{max-height:350px;object-fit:contain}.container{padding:22px 17px 45px}}
</style>
