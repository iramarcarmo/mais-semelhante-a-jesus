---
import Base from '../../layouts/Base.astro';
import{getCollection,render}from'astro:content';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');const url=(p='')=>`${base}/${p.replace(/^\//,'')}`;
export async function getStaticPaths(){const ls=(await getCollection('licoes')).sort((a,b)=>a.data.lesson_number-b.data.lesson_number);return ls.map((l,i)=>({params:{slug:l.id},props:{lesson:l,prev:ls[i-1],next:ls[i+1]}}))}
const {lesson,prev,next}=Astro.props;
const {Content}=await render(lesson);
---
<Base title={lesson.data.title}><div class="container"><a href={url('licoes/')}>← Todas as lições</a><div class="lesson"><article class="paper"><p class="eyebrow">Lição {String(lesson.data.lesson_number).padStart(2,'0')} de 18</p><h1>{lesson.data.title}</h1><img class="lesson-cover" src={url(lesson.data.cover)} alt={`Ilustração da lição ${lesson.data.lesson_number}`}/><div class="prose"><Content/></div><nav class="lesson-nav" aria-label="Navegação entre lições"><div>{prev&&<a class="btn alt" href={url(`licoes/${prev.id}/`)}>← Lição anterior</a>}</div><div>{next?<a class="btn" href={url(`licoes/${next.id}/`)}>Próxima lição →</a>:<a class="btn" href={url('licoes/')}>Todas as lições</a>}</div></nav></article><aside class="sidebar"><span class="eyebrow">Para refletir</span><p>O que esta lição revela sobre o caráter de Jesus?</p><h3>Aprofundamento</h3><p>Leia as passagens bíblicas e observe o contexto.</p><h3>Minha decisão</h3><p>Que atitude concreta vou praticar nesta semana?</p><label for="notes">Minhas anotações</label><textarea id="notes" placeholder="Escreva suas reflexões..." aria-label="Anotações pessoais"></textarea><small class="muted">Anotações não são salvas nem enviadas. Copie-as antes de sair da página.</small></aside></div></div></Base>
